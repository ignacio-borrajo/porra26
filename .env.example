DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=porra26.pythonanywhere.com
MYSQL_NAME=user$porra26
MYSQL_USER=user
MYSQL_PASSWORD=replace-me
MYSQL_HOST=user.mysql.pythonanywhere-services.com
EMAIL_DOMAIN=edisa.com
TEAMS_API_TOKEN=
PORRA_BASE_URL=https://porra26.pythonanywhere.com

# --- Email para cierre de apuestas → Teams ---------------------------------
# Si dejas EMAIL_HOST vacío, base.py cae al backend de consola (los emails
# se imprimen en stdout en vez de enviarse). Útil para dev local. La
# configuración real de producción vive en .env.railway.example (Resend
# por el puerto 2587).
EMAIL_HOST=
EMAIL_PORT=2587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PORRA 26 <onboarding@resend.dev>
# Destinatario al que el management command `send_pending_closures` envía
# el PDF de cierre. Power Automate vigila este buzón y lo republica en Teams.
TEAMS_DESTINATION_EMAIL=ignacio.borrajo@edisa.com
# Prefijo del asunto que filtra el flow de recordatorios en Power Automate.
# Distinto del de cierre ([Porra26]) para que cada flow capture solo lo suyo.
TEAMS_REMINDER_SUBJECT_PREFIX=[Porra26 RECORDATORIO]
