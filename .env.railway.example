# =============================================================================
# Variables de entorno para Railway — PORRA 26
# =============================================================================
# 1. Copia este fichero como `.env` SOLO para pruebas locales contra Postgres.
# 2. En Railway, abre el servicio "web" → pestaña "Variables" y pega cada
#    pareja KEY=VALUE (botón "Raw editor" admite el formato dotenv tal cual).
# 3. NO subas un `.env` real al repo: `.env` está en `.gitignore`.

# -----------------------------------------------------------------------------
# Django básico
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-con-token-aleatorio
# Hosts separados por coma. Railway expone tu dominio en RAILWAY_PUBLIC_DOMAIN
# y `prod.py` lo añade automáticamente, así que aquí basta con el alias o
# dominio propio si lo enlazas.
DJANGO_ALLOWED_HOSTS=porra26.up.railway.app
EMAIL_DOMAIN=edisa.com

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# DATABASE_URL la inyecta Railway automáticamente cuando enlazas el plugin
# de PostgreSQL al servicio. Solo descomenta esta línea si pruebas en local:
# DATABASE_URL=postgres://user:pass@localhost:5432/porra26

# -----------------------------------------------------------------------------
# SMTP saliente vía Resend (https://resend.com)
# -----------------------------------------------------------------------------
# Por qué Resend y no Office 365:
#  - No requiere dominio propio para arrancar: con `onboarding@resend.dev`
#    puedes enviar a la dirección con la que te registraste, suficiente para
#    el flujo email-driven de Teams (la app se envía al buzón que vigila
#    Power Automate).
#  - Free tier: 100 emails/día, 3 000/mes. Sobrado para una porra del Mundial.
#  - No depende de App Passwords de M365 ni del estado del MFA corporativo.
#
# Cuando verifiques un dominio propio en Resend, basta con cambiar
# DEFAULT_FROM_EMAIL al remitente "de marca"; el resto se queda igual.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Usuario fijo que exige Resend en SMTP. NO lo cambies.
EMAIL_HOST_USER=resend
# Pega aquí la API key generada en Resend → API Keys (permiso "Sending access").
EMAIL_HOST_PASSWORD=replace-me-resend-api-key
DEFAULT_FROM_EMAIL=PORRA 26 <onboarding@resend.dev>
# Buzón al que se envían los PDFs de cierre. Power Automate suscribe este
# buzón y al recibir adjunto publica el mensaje en el chat de grupo.
# Mientras no haya dominio verificado en Resend, esta dirección DEBE coincidir
# con la cuenta de Resend; cualquier otra recibirá un "from address not allowed".
TEAMS_DESTINATION_EMAIL=ignacio.borrajo@edisa.com

# -----------------------------------------------------------------------------
# Integración Teams (token Bearer)
# -----------------------------------------------------------------------------
TEAMS_API_TOKEN=replace-me-con-token-aleatorio-64chars
PORRA_BASE_URL=https://porra26.up.railway.app
